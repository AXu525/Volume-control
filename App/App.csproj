<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>AudioVolumeControl.App</RootNamespace>
    <AssemblyName>AudioVolumeControl.App</AssemblyName>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <Description>音量精确控制工具</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AudioVolumeControl\AudioVolumeControl.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.0" />
  </ItemGroup>

</Project>
