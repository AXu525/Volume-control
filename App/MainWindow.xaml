<Window x:Class="AudioVolumeControl.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="音量控制" Height="300" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="ToolWindow"
        Topmost="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="音量精确控制" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

        <!-- 音量控制区域 -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 当前音量显示 -->
            <TextBlock Grid.Row="0" x:Name="VolumeDisplay" Text="音量: 50" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,10"/>

            <!-- 控制目标选择 -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="控制目标:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="TargetComboBox" Width="200" SelectionChanged="TargetComboBox_SelectionChanged"/>
            </StackPanel>

            <!-- 音量输入框 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <TextBlock Text="输入音量:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="VolumeInput" Width="80" Text="50" KeyDown="VolumeInput_KeyDown" LostFocus="VolumeInput_LostFocus"/>
                <TextBlock Text="%" VerticalAlignment="Center" Margin="5,0,0,0"/>
                <Button Content="应用" Click="ApplyButton_Click" Margin="10,0,0,0"/>
            </StackPanel>

            <!-- 音量滑块 -->
            <Slider Grid.Row="3" x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="50"
                    ValueChanged="VolumeSlider_ValueChanged" Margin="0,15,0,0"/>
        </Grid>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Content="静音" Click="MuteButton_Click" x:Name="MuteButton"/>
            <Button Content="设置" Click="SettingsButton_Click"/>
            <Button Content="最小化" Click="MinimizeButton_Click"/>
        </StackPanel>

        <!-- 状态栏 -->
        <TextBlock Grid.Row="3" x:Name="StatusText" Text="就绪" Foreground="Gray" Margin="0,5,0,0"/>
    </Grid>
</Window>
